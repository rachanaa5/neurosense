# Copy to `.env` and fill in. Never commit the real `.env`.

# ThingSpeak channel the wearable publishes to.
THINGSPEAK_CHANNEL_ID=3123361
# Leave blank for a public channel; required for a private one.
THINGSPEAK_READ_API_KEY=

# Seconds between polls in realtime_thingspeak.py (ThingSpeak floor is 15).
POLL_INTERVAL_SECONDS=15

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

API_HOST=127.0.0.1
API_PORT=8000
